# SENTINELLE backend — configuration
# Copier en .env et renseigner les clés pour activer la collecte RÉELLE par plateforme.

SENTINELLE_JWT_SECRET=change-me-in-production
SENTINELLE_DB_URL=sqlite:///./sentinelle.db
SENTINELLE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Connexion par code e-mail à usage unique
#   true  = DÉVELOPPEMENT (code renvoyé dans la réponse, pas d'e-mail)
#   false = PRODUCTION (code envoyé par e-mail via SMTP)
SENTINELLE_AUTH_DEV_MODE=true

# SMTP (requis si AUTH_DEV_MODE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls

# --- Clés API des réseaux sociaux (sources de collecte) ---
# Si une clé est absente, le connecteur tourne en mode DÉMO réaliste.

# X / Twitter — API v2 (Bearer token)
TWITTER_BEARER_TOKEN=

# Facebook — Graph API (lecture des posts de Pages)
#  - Avec token : collecte robuste/légale via Graph API.
#  - Sans token mais avec PAGE_IDS : tentative de scraping public (best-effort, CGU).
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_IDS=        # ex: cameroontribune,237actu,pageofficielle.minpostel
GRAPH_API_VERSION=v21.0

# --- Contournement App Review : fournisseur de scraping Apify ---
# Un seul token suffit pour collecter pages/groupes/posts PUBLICS (FB, IG, TikTok, LinkedIn).
# Création immédiate sur apify.com (pas de validation Facebook).
#
# IMPORTANT — les actors par défaut sont PAYANTS sur l'Apify Store :
#   • FB / IG / TikTok / X / YouTube / LinkedIn = PAY_PER_EVENT (débité du crédit ;
#     fonctionne sur le plan gratuit tant qu'il reste du crédit ~5 $/mois).
#   • Reddit (trudax/reddit-scraper) = abonnement mensuel -> il faut "Rent" l'actor
#     dans la console Apify avant usage (sinon erreur 403 actor-is-not-rented).
# => Sur un plan gratuit, prévoir de petits volumes (limit faible) ou louer les actors.
# Sans token (ou crédit épuisé / actor non loué), le moteur reste en mode DÉMO.
APIFY_TOKEN=
# Cibles publiques à surveiller (URLs ou identifiants, séparés par virgule) :
# (Optionnel — on peut aussi saisir les cibles directement dans « Lancer un scan ».)
WATCH_TARGETS=        # ex: https://www.facebook.com/cameroontribune, https://www.tiktok.com/@xxx
# (Optionnel) surcharge des actors Apify :
# APIFY_FACEBOOK_ACTOR=apify~facebook-posts-scraper
# APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# LinkedIn — OAuth 2.0 access token
LINKEDIN_ACCESS_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Telegram — Telethon (api_id / api_hash) — nécessite aussi une session
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
